# App mode
APP_MODE=saas
DEBUG_WITH_MOCK_DATA=

# SaaS database URL from Supabase (preferred)
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1

# Fallback database URL if needed by tooling
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Session security
SESSION_SECRET=change-me-in-production
AUTH_ERROR_DEBUG=false

# Default password for accounts created by admin
DEFAULT_USER_PASSWORD=password_default

# Password reset email (SaaS mode only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:3000

# Internal cron security and maintenance
CRON_SECRET=
HEARTBEAT_RETENTION_DAYS=180

# Optional debug settings
ENABLE_DEBUG_IMPERSONATION=false
NEXT_PUBLIC_ENABLE_DEBUG_IMPERSONATION=false

# Demo toggle
NEXT_PUBLIC_DEMO_MODE_ENABLED=true
DEMO_TEMPLATE_SCHOOL_CODE=SCH-ALHIKMAH
DEMO_SANDBOX_TTL_HOURS=24
