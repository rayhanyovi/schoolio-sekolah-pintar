# App mode
APP_MODE=self_host
DEBUG_WITH_MOCK_DATA=

# Self-host database URL
DATABASE_URL=postgresql://sekolah_pintar:sekolah_pintar@localhost:5432/sekolah_pintar?schema=public

# Session security
SESSION_SECRET=change-me-in-production
# Set false only for HTTP-only intranet/self-host deployments.
CSRF_COOKIE_SECURE=false

# Default password for accounts created by admin in self-host mode
DEFAULT_USER_PASSWORD=password_default

# Internal cron security and maintenance
CRON_SECRET=
HEARTBEAT_RETENTION_DAYS=180

# Optional debug settings
ENABLE_DEBUG_IMPERSONATION=false
NEXT_PUBLIC_ENABLE_DEBUG_IMPERSONATION=false

# Docker Postgres defaults for self-host
POSTGRES_DB=sekolah_pintar
POSTGRES_USER=sekolah_pintar
POSTGRES_PASSWORD=sekolah_pintar

# App URL
APP_BASE_URL=http://localhost:3000

# Demo toggle
NEXT_PUBLIC_DEMO_MODE_ENABLED=true
DEMO_TEMPLATE_SCHOOL_CODE=SCH-ALHIKMAH
DEMO_SANDBOX_TTL_HOURS=24
